<%- include('partials/head') %>
    <%- include('partials/sidebar') %>
    <main class="flex-grow-1 p-4">
        <%- include('partials/navbar') %>
        <div class="container-fluid py-4">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="fw-bold mb-1"><%= toTitleCase(table) %></h3>
                    <p class="text-muted mb-0">Dynamic CRUD screen generated from the PostgreSQL schema.</p>
                </div>
                <form class="d-flex gap-2" method="get" action="/crud">
                    <input type="hidden" name="table" value="<%= table %>">
                    <input type="text" class="form-control" name="search" placeholder="Search" value="<%= search %>">
                    <button class="btn btn-primary" type="submit">Search</button>
                </form>
            </div>

            <% if (created) { %><div class="alert alert-success">Record created successfully.</div><% } %>
            <% if (updated) { %><div class="alert alert-info">Record updated successfully.</div><% } %>
            <% if (deleted) { %><div class="alert alert-warning">Record deleted successfully.</div><% } %>

            <!-- Create form -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <form method="post" class="row g-3" action="/crud?table=<%= encodeURIComponent(table) %>">
                        <input type="hidden" name="action" value="create">
                        <% for (const col of columns) { %>
                            <% if (col.name === pk) continue; %>
                            <div class="col-md-4">
                                <label class="form-label"><%= toTitleCase(col.name) %></label>
                                <% const opts = fkOptions[col.name] || []; %>
                                <% if (opts.length) { %>
                                    <select class="form-select" name="<%= col.name %>">
                                        <option value="">Select</option>
                                        <% for (const opt of opts) { %>
                                            <option value="<%= opt.value %>"><%= opt.label %></option>
                                        <% } %>
                                    </select>
                                <% } else { %>
                                    <input type="text" class="form-control" name="<%= col.name %>">
                                <% } %>
                            </div>
                        <% } %>
                        <div class="col-12">
                            <button class="btn btn-success" type="submit">Add Record</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Data table -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <% for (const col of columns) { %>
                                        <th>
                                            <a class="text-decoration-none"
                                               href="/crud?table=<%= encodeURIComponent(table) %>&sort=<%= encodeURIComponent(col.name) %>&direction=<%= direction === 'ASC' ? 'DESC' : 'ASC' %>&search=<%= encodeURIComponent(search) %>">
                                                <%= toTitleCase(col.name) %>
                                            </a>
                                        </th>
                                    <% } %>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (const row of rows) { %>
                                    <tr>
                                        <% for (const col of columns) { %>
                                            <td><%= formatValue(row[col.name]) %></td>
                                        <% } %>
                                        <% const recordId = encodeURIComponent(String(row[pk] || row.__row_id || '')); %>
                                        <td>
                                            <a class="btn btn-sm btn-outline-primary" href="/crud?table=<%= encodeURIComponent(table) %>&view=<%= recordId %>">View</a>
                                            <a class="btn btn-sm btn-outline-warning" href="/crud?table=<%= encodeURIComponent(table) %>&edit=<%= recordId %>">Edit</a>
                                            <a class="btn btn-sm btn-outline-danger" href="/crud/delete?table=<%= encodeURIComponent(table) %>&id=<%= recordId %>" data-confirm-delete>Delete</a>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (totalPages > 1) { %>
                    <nav class="mt-3">
                        <ul class="pagination justify-content-end">
                            <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="/crud?table=<%= encodeURIComponent(table) %>&page=1&search=<%= encodeURIComponent(search) %>&sort=<%= encodeURIComponent(sort) %>&direction=<%= direction %>">First</a>
                            </li>
                            <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="/crud?table=<%= encodeURIComponent(table) %>&page=<%= Math.max(1, page - 1) %>&search=<%= encodeURIComponent(search) %>&sort=<%= encodeURIComponent(sort) %>&direction=<%= direction %>">Previous</a>
                            </li>
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <li class="page-item <%= i === page ? 'active' : '' %>">
                                    <a class="page-link" href="/crud?table=<%= encodeURIComponent(table) %>&page=<%= i %>&search=<%= encodeURIComponent(search) %>&sort=<%= encodeURIComponent(sort) %>&direction=<%= direction %>"><%= i %></a>
                                </li>
                            <% } %>
                            <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="/crud?table=<%= encodeURIComponent(table) %>&page=<%= Math.min(totalPages, page + 1) %>&search=<%= encodeURIComponent(search) %>&sort=<%= encodeURIComponent(sort) %>&direction=<%= direction %>">Next</a>
                            </li>
                            <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="/crud?table=<%= encodeURIComponent(table) %>&page=<%= totalPages %>&search=<%= encodeURIComponent(search) %>&sort=<%= encodeURIComponent(sort) %>&direction=<%= direction %>">Last</a>
                            </li>
                        </ul>
                    </nav>
                    <% } %>
                </div>
            </div>

            <!-- View panel -->
            <% if (viewRow) { %>
                <div class="card shadow-sm mt-4">
                    <div class="card-body">
                        <h5 class="card-title">Details</h5>
                        <dl class="row">
                            <% for (const [key, value] of Object.entries(viewRow)) { %>
                                <dt class="col-sm-3"><%= toTitleCase(key) %></dt>
                                <dd class="col-sm-9"><%= formatValue(value) %></dd>
                            <% } %>
                        </dl>
                    </div>
                </div>
            <% } %>

            <!-- Edit panel -->
            <% if (editRow) { %>
                <div class="card shadow-sm mt-4">
                    <div class="card-body">
                        <h5 class="card-title">Edit Record</h5>
                        <form method="post" class="row g-3" action="/crud?table=<%= encodeURIComponent(table) %>">
                            <input type="hidden" name="action" value="update">
                            <input type="hidden" name="<%= pk %>" value="<%= editRow[pk] || editRow.__row_id || '' %>">
                            <% for (const col of columns) { %>
                                <% if (col.name === pk) continue; %>
                                <div class="col-md-4">
                                    <label class="form-label"><%= toTitleCase(col.name) %></label>
                                    <% const opts = fkOptions[col.name] || []; %>
                                    <% if (opts.length) { %>
                                        <select class="form-select" name="<%= col.name %>">
                                            <option value="">Select</option>
                                            <% for (const opt of opts) { %>
                                                <option value="<%= opt.value %>"
                                                    <%= String(editRow[col.name]) === String(opt.value) ? 'selected' : '' %>>
                                                    <%= opt.label %>
                                                </option>
                                            <% } %>
                                        </select>
                                    <% } else { %>
                                        <input type="text" class="form-control"
                                               name="<%= col.name %>"
                                               value="<%= editRow[col.name] || '' %>">
                                    <% } %>
                                </div>
                            <% } %>
                            <div class="col-12">
                                <button class="btn btn-warning" type="submit">Save Changes</button>
                                <a href="/crud?table=<%= encodeURIComponent(table) %>" class="btn btn-secondary ms-2">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            <% } %>

        </div>
        <%- include('partials/footer') %>
    </main>
</div>
</body>
</html>
