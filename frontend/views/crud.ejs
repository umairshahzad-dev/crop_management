<%- include('partials/head') %>
    <%- include('partials/sidebar') %>
    <main class="flex-grow-1 p-4">
        <%- include('partials/navbar') %>
        <div class="container-fluid py-4">

            <!-- Page header + search -->
            <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
                <div>
                    <h4 class="fw-bold mb-0"><%= toTitleCase(table) %></h4>
                    <p class="text-muted small mb-0 mt-1">
                        <i class="bi bi-database me-1"></i>Manage records in <code><%= table %></code>
                    </p>
                </div>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <form class="d-flex gap-2" method="get" action="/crud" style="min-width:240px">
                        <input type="hidden" name="table" value="<%= table %>">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 ps-0"
                                   name="search" placeholder="Search…"
                                   value="<%= search %>" style="box-shadow:none;">
                            <button class="btn btn-primary px-3" type="submit">Go</button>
                        </div>
                    </form>
                    <!-- Add Record button -->
                    <button class="btn btn-success px-4" data-bs-toggle="modal" data-bs-target="#addModal">
                        <i class="bi bi-plus-circle me-2"></i>Add Record
                    </button>
                </div>
            </div>

            <!-- Alerts -->
            <% if (created) { %>
                <div class="alert alert-success alert-dismissible d-flex align-items-center gap-2 fade show mb-4">
                    <i class="bi bi-check-circle-fill"></i><span>Record created successfully.</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (updated) { %>
                <div class="alert alert-info alert-dismissible d-flex align-items-center gap-2 fade show mb-4">
                    <i class="bi bi-pencil-fill"></i><span>Record updated successfully.</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- ── Add Record Modal ───────────────────────────────────── -->
            <div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content" style="border-radius:16px;overflow:hidden;">
                        <div class="modal-header border-bottom py-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center"
                                     style="width:34px;height:34px;background:var(--accent);">
                                    <i class="bi bi-plus-lg text-success fw-bold"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0" id="addModalLabel">Add New <%= toTitleCase(table) %></h6>
                                    <p class="text-muted mb-0" style="font-size:.75rem;">Fill in the fields below</p>
                                </div>
                            </div>
                            <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div id="addFormAlert"></div>
                            <form id="addForm" method="post"
                                  action="/crud?table=<%= encodeURIComponent(table) %>"
                                  class="row g-3">
                                <input type="hidden" name="action" value="create">
                                <% for (const col of columns) { %>
                                    <% if (col.name === pk) continue; %>
                                    <div class="col-sm-6">
                                        <label class="form-label fw-semibold small text-secondary mb-1">
                                            <%= toTitleCase(col.name) %>
                                            <% if (!col.nullable) { %><span class="text-danger ms-1">*</span><% } %>
                                        </label>
                                        <% const opts = fkOptions[col.name] || []; %>
                                        <% if (opts.length) { %>
                                            <select class="form-select form-select-sm crud-input"
                                                    name="<%= col.name %>"
                                                    <% if (!col.nullable) { %>required<% } %>>
                                                <option value="">— Select —</option>
                                                <% for (const opt of opts) { %>
                                                    <option value="<%= opt.value %>"><%= opt.label %></option>
                                                <% } %>
                                            </select>
                                        <% } else { %>
                                            <input type="text"
                                                   class="form-control form-control-sm crud-input"
                                                   name="<%= col.name %>"
                                                   placeholder="<%= toTitleCase(col.name).toLowerCase() %>…"
                                                   <% if (!col.nullable) { %>required<% } %>>
                                        <% } %>
                                    </div>
                                <% } %>
                            </form>
                        </div>
                        <div class="modal-footer border-top py-3">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" form="addForm" class="btn btn-success px-4" id="addSubmitBtn">
                                <i class="bi bi-plus-circle me-2"></i>Add Record
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Data Table ─────────────────────────────────────────── -->
            <div class="card border-0 shadow-sm" style="border-radius:16px;overflow:hidden;">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-table text-primary"></i>
                        <h6 class="fw-bold mb-0">Records</h6>
                        <span class="badge bg-primary bg-opacity-10 text-primary ms-1"><%= total %></span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background:#f8fafc;">
                                <tr>
                                    <% for (const col of columns) { %>
                                        <th class="px-4 py-3 small fw-semibold text-uppercase text-secondary border-0"
                                            style="letter-spacing:.04em;white-space:nowrap;">
                                            <a class="text-decoration-none text-secondary d-flex align-items-center gap-1"
                                               href="/crud?table=<%= encodeURIComponent(table) %>&sort=<%= encodeURIComponent(col.name) %>&direction=<%= direction === 'ASC' ? 'DESC' : 'ASC' %>&search=<%= encodeURIComponent(search) %>">
                                                <%= toTitleCase(col.name) %>
                                                <% if (sort === col.name) { %>
                                                    <i class="bi bi-chevron-<%= direction === 'ASC' ? 'up' : 'down' %> small"></i>
                                                <% } else { %>
                                                    <i class="bi bi-chevron-expand small opacity-50"></i>
                                                <% } %>
                                            </a>
                                        </th>
                                    <% } %>
                                    <th class="px-4 py-3 small fw-semibold text-uppercase text-secondary border-0">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                <% if (rows.length === 0) { %>
                                    <tr>
                                        <td colspan="<%= columns.length + 1 %>" class="text-center py-5 text-muted">
                                            <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                                            No records found<% if (search) { %> for "<%= search %>"<% } %>.
                                        </td>
                                    </tr>
                                <% } %>
                                <% for (const row of rows) { %>
                                    <tr class="border-top">
                                        <% for (const col of columns) { %>
                                            <td class="px-4 py-3 small"><%= formatValue(row[col.name]) %></td>
                                        <% } %>
                                        <% const recordId = encodeURIComponent(String(row[pk] || row.__row_id || '')); %>
                                        <td class="px-4 py-3">
                                            <div class="d-flex gap-1 flex-nowrap">
                                                <a class="btn btn-sm btn-outline-primary"
                                                   href="/crud?table=<%= encodeURIComponent(table) %>&view=<%= recordId %>"
                                                   title="View"><i class="bi bi-eye"></i></a>
                                                <a class="btn btn-sm btn-outline-warning"
                                                   href="/crud?table=<%= encodeURIComponent(table) %>&edit=<%= recordId %>"
                                                   title="Edit"><i class="bi bi-pencil"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (totalPages > 1) { %>
                    <div class="d-flex align-items-center justify-content-between px-4 py-3 border-top">
                        <span class="small text-muted">Page <%= page %> of <%= totalPages %> · <%= total %> records</span>
                        <nav>
                            <ul class="pagination pagination-sm mb-0 gap-1">
                                <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
                                    <a class="page-link rounded" href="/crud?table=<%= encodeURIComponent(table) %>&page=1&search=<%= encodeURIComponent(search) %>&sort=<%= encodeURIComponent(sort) %>&direction=<%= direction %>">
                                        <i class="bi bi-chevron-double-left"></i></a>
                                </li>
                                <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
                                    <a class="page-link rounded" href="/crud?table=<%= encodeURIComponent(table) %>&page=<%= Math.max(1, page-1) %>&search=<%= encodeURIComponent(search) %>&sort=<%= encodeURIComponent(sort) %>&direction=<%= direction %>">
                                        <i class="bi bi-chevron-left"></i></a>
                                </li>
                                <% const ps = Math.max(1,page-2), pe = Math.min(totalPages,page+2); %>
                                <% for (let i = ps; i <= pe; i++) { %>
                                    <li class="page-item <%= i===page?'active':'' %>">
                                        <a class="page-link rounded" href="/crud?table=<%= encodeURIComponent(table) %>&page=<%= i %>&search=<%= encodeURIComponent(search) %>&sort=<%= encodeURIComponent(sort) %>&direction=<%= direction %>"><%= i %></a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= page===totalPages?'disabled':'' %>">
                                    <a class="page-link rounded" href="/crud?table=<%= encodeURIComponent(table) %>&page=<%= Math.min(totalPages,page+1) %>&search=<%= encodeURIComponent(search) %>&sort=<%= encodeURIComponent(sort) %>&direction=<%= direction %>">
                                        <i class="bi bi-chevron-right"></i></a>
                                </li>
                                <li class="page-item <%= page===totalPages?'disabled':'' %>">
                                    <a class="page-link rounded" href="/crud?table=<%= encodeURIComponent(table) %>&page=<%= totalPages %>&search=<%= encodeURIComponent(search) %>&sort=<%= encodeURIComponent(sort) %>&direction=<%= direction %>">
                                        <i class="bi bi-chevron-double-right"></i></a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- View panel -->
            <% if (viewRow) { %>
                <div class="card border-0 shadow-sm mt-4" style="border-radius:16px;">
                    <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center gap-2">
                        <i class="bi bi-eye text-primary"></i>
                        <h6 class="fw-bold mb-0">Record Details</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <% for (const [key, value] of Object.entries(viewRow)) { %>
                                <div class="col-sm-6 col-lg-4">
                                    <div class="p-3 rounded-3 h-100" style="background:#f8fafc;">
                                        <div class="text-muted small mb-1"><%= toTitleCase(key) %></div>
                                        <div class="fw-semibold"><%= formatValue(value) %></div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                        <div class="mt-3">
                            <a href="/crud?table=<%= encodeURIComponent(table) %>" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back
                            </a>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- Edit panel -->
            <% if (editRow) { %>
                <div class="card border-0 shadow-sm mt-4" style="border-radius:16px;overflow:hidden;">
                    <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:34px;height:34px;background:#fff8e1;">
                            <i class="bi bi-pencil text-warning"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">Edit Record</h6>
                            <p class="text-muted mb-0" style="font-size:.75rem;">Update the fields below</p>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" class="row g-3" action="/crud?table=<%= encodeURIComponent(table) %>">
                            <input type="hidden" name="action" value="update">
                            <input type="hidden" name="<%= pk %>" value="<%= editRow[pk] || editRow.__row_id || '' %>">
                            <% for (const col of columns) { %>
                                <% if (col.name === pk) continue; %>
                                <div class="col-sm-6 col-lg-4">
                                    <label class="form-label fw-semibold small text-secondary mb-1">
                                        <%= toTitleCase(col.name) %>
                                    </label>
                                    <% const opts = fkOptions[col.name] || []; %>
                                    <% if (opts.length) { %>
                                        <select class="form-select form-select-sm crud-input" name="<%= col.name %>">
                                            <option value="">— Select —</option>
                                            <% for (const opt of opts) { %>
                                                <option value="<%= opt.value %>"
                                                    <%= String(editRow[col.name]) === String(opt.value) ? 'selected' : '' %>>
                                                    <%= opt.label %>
                                                </option>
                                            <% } %>
                                        </select>
                                    <% } else { %>
                                        <input type="text" class="form-control form-control-sm crud-input"
                                               name="<%= col.name %>"
                                               value="<%= editRow[col.name] || '' %>">
                                    <% } %>
                                </div>
                            <% } %>
                            <div class="col-12 pt-1 d-flex gap-2">
                                <button class="btn btn-warning px-4" type="submit">
                                    <i class="bi bi-save me-2"></i>Save Changes
                                </button>
                                <a href="/crud?table=<%= encodeURIComponent(table) %>" class="btn btn-outline-secondary">
                                    <i class="bi bi-x-lg me-1"></i>Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            <% } %>

        </div>
        <%- include('partials/footer') %>
    </main>
</div>

<style>
.crud-input { border-radius:8px;border-color:#e2e8f0;transition:border-color .2s,box-shadow .2s; }
.crud-input:focus { border-color:#1f5f3d;box-shadow:0 0 0 3px rgba(31,95,61,.12); }
.pagination .page-link { border-radius:8px!important;border-color:#e2e8f0;color:#4b5563; }
.pagination .page-item.active .page-link { background:#1f5f3d;border-color:#1f5f3d; }
</style>

<script>
// Submit Add form via JSON API — close modal and reload on success
document.getElementById('addForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('addSubmitBtn');
    const alertBox = document.getElementById('addFormAlert');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving…';
    alertBox.innerHTML = '';

    // Clear previous errors
    this.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));

    try {
        const body = new URLSearchParams(new FormData(this)).toString();
        const res = await fetch(`/crud/api?table=<%= encodeURIComponent(table) %>`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body
        });
        const result = await res.json();

        if (result.success) {
            bootstrap.Modal.getInstance(document.getElementById('addModal')).hide();
            this.reset();
            window.location.href = '/crud?table=<%= encodeURIComponent(table) %>&created=1&page=<%= page %>&search=<%= encodeURIComponent(search) %>';
        } else {
            const errList = result.errors || ['Failed to add record.'];
            alertBox.innerHTML = `
                <div class="alert alert-danger py-2 mb-3">
                    <strong><i class="bi bi-exclamation-triangle-fill me-1"></i>Please fix the following:</strong>
                    <ul class="mb-0 mt-1 ps-3">
                        ${errList.map(e => `<li class="small">${e}</li>`).join('')}
                    </ul>
                </div>`;
        }
    } catch (err) {
        alertBox.innerHTML = '<div class="alert alert-danger py-2 small"><i class="bi bi-wifi-off me-1"></i>Network error. Please try again.</div>';
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-plus-circle me-2"></i>Add Record';
    }
});
</script>
</body>
</html>
