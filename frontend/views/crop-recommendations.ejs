<%- include('partials/head') %>
    <%- include('partials/sidebar') %>
    <main class="flex-grow-1 p-4">
        <%- include('partials/navbar') %>
        <div class="container-fluid py-4">

            <!-- ── Header ─────────────────────────────────────────────── -->
            <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
                <div>
                    <h4 class="fw-bold mb-0">Crop Recommendations</h4>
                    <p class="text-muted small mb-0 mt-1">
                        <i class="bi bi-flower1 me-1"></i>January shown by default · click Show More to expand all months
                    </p>
                </div>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <form class="d-flex gap-0" method="get" action="/crud">
                        <input type="hidden" name="table" value="crop_recommendations">
                        <div class="input-group" style="min-width:220px;">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 ps-0"
                                   name="search" placeholder="Search district…"
                                   value="<%= search %>" style="box-shadow:none;">
                            <button class="btn btn-primary" type="submit">Go</button>
                        </div>
                    </form>
                    <button class="btn btn-success px-4" data-bs-toggle="modal" data-bs-target="#addCropModal">
                        <i class="bi bi-plus-circle me-2"></i>Add Record
                    </button>
                </div>
            </div>

            <!-- ── Alerts ─────────────────────────────────────────────── -->
            <% if (created) { %>
                <div class="alert alert-success alert-dismissible d-flex align-items-center gap-2 fade show mb-4">
                    <i class="bi bi-check-circle-fill"></i><span>Record created successfully.</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (updated) { %>
                <div class="alert alert-info alert-dismissible d-flex align-items-center gap-2 fade show mb-4">
                    <i class="bi bi-pencil-fill"></i><span>Record updated successfully.</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- ── Add Record Modal ───────────────────────────────────── -->
            <div class="modal fade" id="addCropModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content" style="border-radius:16px;overflow:hidden;">
                        <div class="modal-header border-bottom py-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center"
                                     style="width:34px;height:34px;background:var(--accent);">
                                    <i class="bi bi-plus-lg text-success fw-bold"></i>
                                </div>
                                <h6 class="fw-bold mb-0">Add New Recommendation</h6>
                            </div>
                            <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div id="cropAddAlert"></div>
                            <form id="cropAddForm" method="post"
                                  action="/crud?table=crop_recommendations"
                                  class="row g-3">
                                <input type="hidden" name="action" value="create">
                                <% for (const col of columns) { %>
                                    <div class="col-sm-6">
                                        <label class="form-label fw-semibold small text-secondary mb-1">
                                            <%= toTitleCase(col.name) %>
                                        </label>
                                        <% const opts = fkOptions[col.name] || []; %>
                                        <% if (opts.length) { %>
                                            <select class="form-select form-select-sm crud-input" name="<%= col.name %>">
                                                <option value="">— Select —</option>
                                                <% for (const opt of opts) { %>
                                                    <option value="<%= opt.value %>"><%= opt.label %></option>
                                                <% } %>
                                            </select>
                                        <% } else if (col.name === 'month') { %>
                                            <select class="form-select form-select-sm crud-input" name="month">
                                                <option value="">— Select Month —</option>
                                                <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach(m => { %>
                                                    <option value="<%= m %>"><%= m %></option>
                                                <% }); %>
                                            </select>
                                        <% } else if (col.name === 'season') { %>
                                            <select class="form-select form-select-sm crud-input" name="season">
                                                <option value="">— Select Season —</option>
                                                <option value="Rabi">Rabi</option>
                                                <option value="Kharif">Kharif</option>
                                                <option value="Zaid">Zaid</option>
                                            </select>
                                        <% } else { %>
                                            <input type="text" class="form-control form-control-sm crud-input"
                                                   name="<%= col.name %>"
                                                   placeholder="<%= toTitleCase(col.name).toLowerCase() %>…">
                                        <% } %>
                                    </div>
                                <% } %>
                            </form>
                        </div>
                        <div class="modal-footer border-top py-3">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" form="cropAddForm" id="cropAddBtn" class="btn btn-success px-4">
                                <i class="bi bi-plus-circle me-2"></i>Add Record
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Stats bar ──────────────────────────────────────────── -->
            <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                    <i class="bi bi-geo-alt-fill me-1"></i><%= totalDistricts %> Districts
                </span>
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                    <i class="bi bi-calendar3 me-1"></i><%= totalRows %> Total Records
                </span>
                <div class="ms-auto d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" onclick="toggleAll(true)">
                        <i class="bi bi-arrows-expand me-1"></i>Expand All
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="toggleAll(false)">
                        <i class="bi bi-arrows-collapse me-1"></i>Collapse All
                    </button>
                </div>
            </div>

            <!-- ── Empty state ────────────────────────────────────────── -->
            <% if (grouped.length === 0) { %>
                <div class="card border-0 shadow-sm text-center py-5" style="border-radius:16px;">
                    <i class="bi bi-inbox fs-1 text-muted opacity-50 d-block mb-2"></i>
                    <p class="text-muted">No records found<% if (search) { %> for "<%= search %>"<% } %>.</p>
                </div>
            <% } %>

            <!-- ── District groups ────────────────────────────────────── -->
            <% for (let gi = 0; gi < grouped.length; gi++) { %>
                <% const g = grouped[gi]; %>
                <div class="card border-0 shadow-sm mb-3 district-card" style="border-radius:14px;overflow:hidden;">
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <!-- Show column headers only on first card -->
                            <% if (gi === 0) { %>
                            <thead style="background:#f0faf4;">
                                <tr>
                                    <% for (const col of columns) { %>
                                        <th class="px-4 py-3 small fw-semibold text-uppercase text-secondary border-0"
                                            style="letter-spacing:.04em;white-space:nowrap;">
                                            <%= toTitleCase(col.name) %>
                                        </th>
                                    <% } %>
                                    <th class="px-4 py-3 small fw-semibold text-uppercase text-secondary border-0">Actions</th>
                                </tr>
                            </thead>
                            <% } %>
                            <tbody>
                                <tr class="border-top">
                                    <% for (const col of columns) { %>
                                        <td class="px-4 py-3 small">
                                            <% if (col.name === 'district_name') { %>
                                                <span class="fw-semibold text-dark"><%= formatValue(g.first[col.name]) %></span>
                                            <% } else if (col.name === 'month') { %>
                                                <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill">
                                                    <%= formatValue(g.first[col.name]) %>
                                                </span>
                                            <% } else { %>
                                                <%= formatValue(g.first[col.name]) %>
                                            <% } %>
                                        </td>
                                    <% } %>
                                    <td class="px-4 py-3">
                                        <div class="d-flex gap-1">
                                            <a class="btn btn-sm btn-outline-primary"
                                               href="/crud?table=crop_recommendations&view=<%= encodeURIComponent(String(g.pk)) %>"
                                               title="View"><i class="bi bi-eye"></i></a>
                                            <a class="btn btn-sm btn-outline-warning"
                                               href="/crud?table=crop_recommendations&edit=<%= encodeURIComponent(String(g.pk)) %>"
                                               title="Edit"><i class="bi bi-pencil"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Remaining months (collapsible) -->
                    <% if (g.rest.length > 0) { %>
                        <div class="collapse month-collapse" id="months-<%= gi %>">
                            <div class="border-top" style="background:#fafcfa;">
                                <table class="table table-hover align-middle mb-0">
                                    <tbody>
                                        <% for (const row of g.rest) { %>
                                            <tr>
                                                <% for (const col of columns) { %>
                                                    <td class="px-4 py-2 small">
                                                        <% if (col.name === 'district_name') { %>
                                                            <span class="text-muted"><%= formatValue(row[col.name]) %></span>
                                                        <% } else if (col.name === 'month') { %>
                                                            <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 rounded-pill">
                                                                <%= formatValue(row[col.name]) %>
                                                            </span>
                                                        <% } else { %>
                                                            <%= formatValue(row[col.name]) %>
                                                        <% } %>
                                                    </td>
                                                <% } %>
                                                <td class="px-4 py-2">
                                                    <div class="d-flex gap-1">
                                                        <a class="btn btn-sm btn-outline-primary"
                                                           href="/crud?table=crop_recommendations&view=<%= encodeURIComponent(String(row.id || '')) %>"
                                                           title="View"><i class="bi bi-eye"></i></a>
                                                        <a class="btn btn-sm btn-outline-warning"
                                                           href="/crud?table=crop_recommendations&edit=<%= encodeURIComponent(String(row.id || '')) %>"
                                                           title="Edit"><i class="bi bi-pencil"></i></a>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="px-4 py-2 border-top d-flex align-items-center justify-content-between"
                             style="background:#f8fafc;">
                            <span class="small text-muted"><%= g.rest.length %> more month<%= g.rest.length > 1 ? 's' : '' %></span>
                            <button class="btn btn-sm btn-link text-decoration-none text-success p-0 toggle-btn"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#months-<%= gi %>"
                                    onclick="handleToggle(this)">
                                <i class="bi bi-chevron-down me-1"></i>Show More
                            </button>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <!-- ── Pagination ─────────────────────────────────────────── -->
            <% if (totalPages > 1) { %>
            <div class="d-flex align-items-center justify-content-between mt-4 flex-wrap gap-2">
                <span class="small text-muted">
                    Districts <%= (page-1)*10+1 %>–<%= Math.min(page*10, totalDistricts) %>
                    of <strong><%= totalDistricts %></strong>
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0 gap-1">
                        <li class="page-item <%= page===1?'disabled':'' %>">
                            <a class="page-link rounded" href="/crud?table=crop_recommendations&page=1&search=<%= encodeURIComponent(search) %>">
                                <i class="bi bi-chevron-double-left"></i></a></li>
                        <li class="page-item <%= page===1?'disabled':'' %>">
                            <a class="page-link rounded" href="/crud?table=crop_recommendations&page=<%= Math.max(1,page-1) %>&search=<%= encodeURIComponent(search) %>">
                                <i class="bi bi-chevron-left"></i></a></li>
                        <% const ps=Math.max(1,page-2), pe=Math.min(totalPages,page+2); %>
                        <% for(let i=ps;i<=pe;i++){ %>
                            <li class="page-item <%= i===page?'active':'' %>">
                                <a class="page-link rounded" href="/crud?table=crop_recommendations&page=<%= i %>&search=<%= encodeURIComponent(search) %>"><%= i %></a></li>
                        <% } %>
                        <li class="page-item <%= page===totalPages?'disabled':'' %>">
                            <a class="page-link rounded" href="/crud?table=crop_recommendations&page=<%= Math.min(totalPages,page+1) %>&search=<%= encodeURIComponent(search) %>">
                                <i class="bi bi-chevron-right"></i></a></li>
                        <li class="page-item <%= page===totalPages?'disabled':'' %>">
                            <a class="page-link rounded" href="/crud?table=crop_recommendations&page=<%= totalPages %>&search=<%= encodeURIComponent(search) %>">
                                <i class="bi bi-chevron-double-right"></i></a></li>
                    </ul>
                </nav>
            </div>
            <% } %>

        </div>
        <%- include('partials/footer') %>
    </main>
</div>

<style>
.crud-input{border-radius:8px;border-color:#e2e8f0;transition:border-color .2s,box-shadow .2s;}
.crud-input:focus{border-color:#1f5f3d;box-shadow:0 0 0 3px rgba(31,95,61,.12);}
.district-card{transition:box-shadow .2s;}
.district-card:hover{box-shadow:0 4px 16px rgba(0,0,0,.08)!important;}
.toggle-btn{font-size:.85rem;}
.pagination .page-link{border-radius:8px!important;border-color:#e2e8f0;color:#4b5563;}
.pagination .page-item.active .page-link{background:#1f5f3d;border-color:#1f5f3d;}
</style>

<script>
function handleToggle(btn) {
    const target = document.querySelector(btn.getAttribute('data-bs-target'));
    const willExpand = !target.classList.contains('show');
    btn.innerHTML = willExpand
        ? '<i class="bi bi-chevron-up me-1"></i>Show Less'
        : '<i class="bi bi-chevron-down me-1"></i>Show More';
}

function toggleAll(expand) {
    document.querySelectorAll('.month-collapse').forEach(el => {
        bootstrap.Collapse.getOrCreateInstance(el, {toggle:false})[expand?'show':'hide']();
    });
    document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.innerHTML = expand
            ? '<i class="bi bi-chevron-up me-1"></i>Show Less'
            : '<i class="bi bi-chevron-down me-1"></i>Show More';
    });
}

// AJAX submit for Add Record modal — uses JSON API endpoint
document.getElementById('cropAddForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('cropAddBtn');
    const alertBox = document.getElementById('cropAddAlert');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving…';
    alertBox.innerHTML = '';

    // Clear previous field errors
    this.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
    this.querySelectorAll('.invalid-feedback').forEach(el => el.remove());

    try {
        const formData = new FormData(this);
        const body = new URLSearchParams(formData).toString();
        const table = '<%= encodeURIComponent(table) %>';

        const res = await fetch(`/crud/api?table=${table}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body
        });

        const result = await res.json();

        if (result.success) {
            bootstrap.Modal.getInstance(document.getElementById('addCropModal')).hide();
            this.reset();
            window.location.href = `/crud?table=crop_recommendations&created=1&page=<%= page %>`;
        } else {
            // Show errors inline
            const errList = result.errors || ['Failed to add record.'];
            alertBox.innerHTML = `
                <div class="alert alert-danger py-2 mb-3">
                    <strong><i class="bi bi-exclamation-triangle-fill me-1"></i>Please fix the following:</strong>
                    <ul class="mb-0 mt-1 ps-3">
                        ${errList.map(e => `<li class="small">${e}</li>`).join('')}
                    </ul>
                </div>`;
        }
    } catch (err) {
        alertBox.innerHTML = '<div class="alert alert-danger py-2 small"><i class="bi bi-wifi-off me-1"></i>Network error. Please try again.</div>';
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-plus-circle me-2"></i>Add Record';
    }
});
</script>
</body>
</html>
