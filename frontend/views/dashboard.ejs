<%- include('partials/head') %>
    <%- include('partials/sidebar') %>
    <main class="flex-grow-1 p-4">
        <%- include('partials/navbar') %>
        <div class="container-fluid py-4">

            <div class="mb-4">
                <h3 class="fw-bold mb-1">Dashboard</h3>
                <p class="text-muted mb-0">Overview of the Crop Recommendation System.</p>
            </div>

            <!-- Stats -->
            <div class="row g-3 mb-4">
                <% for (const [key, card] of Object.entries(statCards)) { %>
                    <% if (stats[key] === undefined) continue; %>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card card-stat h-100">
                            <div class="card-body d-flex flex-column align-items-start gap-2 p-3">
                                <div class="rounded-circle bg-<%= card.color %> bg-opacity-10 p-2">
                                    <i class="bi <%= card.icon %> text-<%= card.color %> fs-5"></i>
                                </div>
                                <div class="fs-3 fw-bold lh-1"><%= stats[key].toLocaleString() %></div>
                                <div class="text-muted small"><%= card.label %></div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Quick navigation -->
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Quick Navigation</h5>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="/district-details" class="btn btn-outline-success">
                                    <i class="bi bi-geo-alt-fill me-1"></i>District Explorer
                                </a>
                                <% for (const t of tables) { %>
                                    <a href="/crud?table=<%= encodeURIComponent(t) %>" class="btn btn-outline-primary">
                                        <i class="bi <%= tableIcons[t] || 'bi-table' %> me-1"></i>
                                        <%= t.replace(/_/g,' ').replace(/\w\S*/g, w => w[0].toUpperCase()+w.slice(1).toLowerCase()) %>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modules table -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Database Modules</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Module</th>
                                    <th>Table Name</th>
                                    <th class="text-end">Records</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (const t of tables) { %>
                                    <tr>
                                        <td>
                                            <i class="bi <%= tableIcons[t] || 'bi-table' %> me-2 text-primary"></i>
                                            <span class="fw-semibold">
                                                <%= t.replace(/_/g,' ').replace(/\w\S*/g, w => w[0].toUpperCase()+w.slice(1).toLowerCase()) %>
                                            </span>
                                        </td>
                                        <td><code><%= t %></code></td>
                                        <td class="text-end"><%= (counts[t] || 0).toLocaleString() %></td>
                                        <td>
                                            <a href="/crud?table=<%= encodeURIComponent(t) %>" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil-square me-1"></i>Manage
                                            </a>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
        <%- include('partials/footer') %>
    </main>
</div>
</body>
</html>
