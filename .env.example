# ── Option 1: Single connection string (Neon / cloud databases) ─────────────
# Vercel+Neon integration sets this automatically. For local use, paste your
# Neon connection string here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Option 2: Individual variables (local PostgreSQL) ────────────────────────
# Used when DATABASE_URL is NOT set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crop_management
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
